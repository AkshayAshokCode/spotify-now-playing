{% extends "base.html.j2" %}

{% block container_styles %}
/* Dark theme - background is drawn by svg_background; keep HTML transparent */
background-color: transparent;
border: 1px solid var(--border-color);
{% endblock %}

{% block svg_background %}
<rect width="{{ width }}" height="{{ height }}" rx="{{ border_radius }}" fill="#{{ background_color }}"/>
{% endblock %}

{% block theme_styles %}
/* Dark theme specific overrides */
.song-text {
    font-weight: 500;
}

.artist-text {
    opacity: 0.9;
}

.cover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
}

{% endblock %}
